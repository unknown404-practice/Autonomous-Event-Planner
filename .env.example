# EventPilot AI Configuration

# Database (Default SQLite local file)
DATABASE_URL="file:./dev.db"

# OpenRouter API (Free models supported, e.g. meta-llama/llama-3.3-70b-instruct:free)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct:free"

# Optional: Google Gemini API fallback
GEMINI_API_KEY=""

# Application Environment
NODE_ENV="development"
PORT="3000"
