# EventPilot AI Configuration

# Database (Default SQLite local file)
DATABASE_URL="file:./dev.db"

# OpenRouter API (Auto-routed free tier supported: openrouter/free)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openrouter/free"

# Optional: Google Gemini API fallback
GEMINI_API_KEY=""

# Application Environment
NODE_ENV="development"
PORT="3000"
