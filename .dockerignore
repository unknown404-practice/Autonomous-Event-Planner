# ==============================================================================
# EventPilot AI - Docker Ignore Policy
# Prevents host credentials, databases, secrets, and caches from leaking into Docker images
# ==============================================================================

# Node dependencies and package caches
node_modules
.pnp
.pnp.js

# Build artifacts & cache
.next
out
build
dist
*.tsbuildinfo

# SQLite databases, local journals, and storage volumes
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
dev.db*
prisma/*.db
prisma/*.db-journal
prisma/*.db-shm
prisma/*.db-wal
prisma/dev.db*

# Local environment variables & secrets
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production
.env.staging
!.env.example

# Private cryptographic keys, certificates & credentials
*.pem
*.key
*.crt
*.cert
*.pfx
*.p12
id_rsa*
id_ed25519*
*.pub
credentials*.json
client_secret*.json
service-account*.json

# Git repository metadata
.git
.gitignore
.github

# Developer & agent tools, scratch files, and markdown
.agents
scratch
.gemini
*.tmp
*.temp

# Test suite and coverage reports
tests
coverage
.nyc_output

# IDE and OS metadata
.vscode
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
.DS_Store
Thumbs.db

# Runtime logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
